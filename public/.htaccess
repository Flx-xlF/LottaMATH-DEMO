# ==============================================================================
# LottaMATH — Root Server Configuration & Security (.htaccess for cyon.ch)
# ==============================================================================

# 1. Enable UTF-8 default charset
AddDefaultCharset UTF-8

# 2. Prevent Directory Browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# 3. Security Headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Restrict device permissions
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# 4. Cache-Control & PWA Freshness
<IfModule mod_expires.c>
    ExpiresActive On

    # Long cache for hashed static assets (1 year)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"

    # HTML, ServiceWorker & Webmanifest must always be revalidated
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Ensure Service Worker and HTML are never served stale
    <FilesMatch "(sw\.js|manifest\.json|index\.html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # Cache immutable assets with max-age
    <FilesMatch "\.(css|js|woff2?|ttf|png|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 5. Block Access to Hidden / Dot Files (.git, .env, .htpasswd, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 6. Gzip / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json font/woff font/woff2
</IfModule>

# ==============================================================================
# Optional: Password Protection (Methode B via .htpasswd)
# Wenn du den Verzeichnisschutz im Cyon Control Panel aktivierst (Methode A),
# verwaltet Cyon dies automatisch. Falls manuell gewünscht, Zeilen einkommentieren:
#
# AuthType Basic
# AuthName "LottaMATH - Bitte anmelden"
# AuthUserFile /home/DEIN_CYON_BENUTZERNAME/public_html/lottamath.deinedomain.ch/.htpasswd
# Require valid-user
# ==============================================================================
